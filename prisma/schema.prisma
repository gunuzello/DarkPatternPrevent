generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Shop {
  id               String    @id
  url              String
  ownerHash        String
  consentAt        DateTime  @default(now())
  verificationHash String?
  verifiedAt       DateTime?
  plan             String    @default("FREE")
  scans            Scan[]
}

model Scan {
  id              String    @id
  scenario        String
  executionMode   String    @default("STATIC")
  viewport        String    @default("DESKTOP")
  purchasePath    String    @default("CART")
  targetUrl       String
  status          String
  createdAt       DateTime  @default(now())
  reportPath      String?
  shopId          String?
  shop            Shop?     @relation(fields: [shopId], references: [id])
  startedAt       DateTime?
  durationMs      Int?
  progress        Int       @default(0)
  currentStage    String?
  cancelRequested Boolean   @default(false)
  credentialCiphertext String?
  findings        Finding[]
  baselineScanId  String?
  baseline        Scan?     @relation("ScanBaseline", fields: [baselineScanId], references: [id], onDelete: SetNull)
  rescans         Scan[]    @relation("ScanBaseline")
  aiReview         AiReview?

  @@index([baselineScanId])

  @@index([status, createdAt])
}

model AiReview {
  id             String    @id
  scanId         String    @unique
  scan           Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  status         String    @default("QUEUED")
  requestedAt    DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  provider       String?
  model          String?
  candidateCount Int       @default(0)
  resultJson     String?
  usageJson      String?
  error          String?

  @@index([status, requestedAt])
}

model Finding {
  id          Int    @id @default(autoincrement())
  scanId      String
  scan        Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  type        String
  status      String
  stage       String
  reason      String
  ruleVersion String

  @@index([scanId])
}

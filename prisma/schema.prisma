generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Shop {
  id               String    @id
  url              String
  ownerHash        String
  consentAt        DateTime  @default(now())
  verificationHash String?
  verifiedAt       DateTime?
  scans            Scan[]
}

model Scan {
  id              String    @id
  scenario        String
  targetUrl       String
  status          String
  createdAt       DateTime  @default(now())
  reportPath      String?
  shopId          String?
  shop            Shop?     @relation(fields: [shopId], references: [id])
  startedAt       DateTime?
  progress        Int       @default(0)
  cancelRequested Boolean   @default(false)
  findings        Finding[]
  baselineScanId  String?
  baseline        Scan?     @relation("ScanBaseline", fields: [baselineScanId], references: [id], onDelete: SetNull)
  rescans         Scan[]    @relation("ScanBaseline")

  @@index([baselineScanId])

  @@index([status, createdAt])
}

model Finding {
  id          Int    @id @default(autoincrement())
  scanId      String
  scan        Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  type        String
  status      String
  stage       String
  reason      String
  ruleVersion String

  @@index([scanId])
}
